PORT=4000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/next_hunt_ems?retryWrites=true&w=majority&appName=Cluster0

# Authentication (JWT)
JWT_SECRET=replace_with_a_strong_64_character_random_secret
JWT_EXPIRATION=86400

# Nodemailer (Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=Next Hunt Management System

# Optional copy recipient for new user registration notifications
HR_NOTIFICATION_EMAIL=hr_alerts@yourcompany.com

# Default Seeded HR Super Admin Account
DEFAULT_HR_NAME=HR Super Admin
DEFAULT_HR_EMAIL=hr@nexthunt.com
DEFAULT_HR_PASSWORD=NextHunt@HR123

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
